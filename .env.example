# SmartCheck production database
DATABASE_URL=

# Required for signed HttpOnly sessions (use a long random value)
SMARTCHECK_SESSION_SECRET=

# Bootstrap platform administrator (use only for initial platform access)
SMARTCHECK_PLATFORM_ADMIN_USERNAME=
SMARTCHECK_PLATFORM_ADMIN_PASSWORD=

# Optional Google integration/export (not required for parent requests)
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

NEXT_PUBLIC_APP_NAME=SmartCheck
